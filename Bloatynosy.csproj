<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Bloatynosy</AssemblyName>
    <!-- the name is a name, not a word: Application.ProductName reads it, nothing translates it -->
    <Product>Bloatynosy</Product>
    <RootNamespace>Bloatynosy</RootNamespace>
    <Version>1.01.120</Version>
    <AssemblyVersion>1.01.120</AssemblyVersion>
    <FileVersion>1.01.120</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- anycpu, not x64: the winforms designer host cannot load a pe32plus assembly.
         prefer32bit false keeps the process 64 bit, so the registry view stays unredirected -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- one dll with no dependency chain, so no binding redirect and no config parse at startup -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- subtype makes visual studio offer the designer; dependentupon nests its generated files
       under the source you open. without the first, a form opens as code. -->
  <ItemGroup>
    <Compile Update="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MainForm.Commands.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Controls\SearchField.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controls\SearchField.Designer.cs"><DependentUpon>SearchField.cs</DependentUpon></Compile>

    <Compile Update="Views\CheckView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Views\CheckView.Designer.cs"><DependentUpon>CheckView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Views\CheckView.resx"><DependentUpon>CheckView.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Views\NavView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Views\NavView.Designer.cs"><DependentUpon>NavView.cs</DependentUpon></Compile>

    <Compile Update="Views\ResultView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Views\ResultView.Designer.cs"><DependentUpon>ResultView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Views\ResultView.resx"><DependentUpon>ResultView.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Views\SettingsView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Views\SettingsView.Designer.cs"><DependentUpon>SettingsView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Views\SettingsView.resx"><DependentUpon>SettingsView.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Views\ReportView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Views\ReportView.Designer.cs"><DependentUpon>ReportView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Views\ReportView.resx"><DependentUpon>ReportView.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Views\AppRemovalDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Views\AppRemovalDialog.Designer.cs"><DependentUpon>AppRemovalDialog.cs</DependentUpon></Compile>
    <Compile Update="Views\DetailWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Views\DetailWindow.Designer.cs"><DependentUpon>DetailWindow.cs</DependentUpon></Compile>
  </ItemGroup>

  <!-- tweak plugins, app rules and the mark are assets beside the app, never payload in the exe -->
  <ItemGroup>
    <None Update="Data\*.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="AppIcon.ico" />
  </ItemGroup>

</Project>
